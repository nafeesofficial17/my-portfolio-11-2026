# Copy to .env.local and fill in. Never commit .env.local.

# Contact form email delivery (https://resend.com → API Keys).
# Without it, messages are only logged in development, and the form asks visitors to email you in production.
RESEND_API_KEY=

# Who receives contact form messages (defaults to the email in src/data/profile.ts).
CONTACT_TO_EMAIL=nafeesofficial17@gmail.com

# Sender address. Must be on a domain verified in Resend; the default test sender
# (onboarding@resend.dev) can only deliver to your own Resend account email.
CONTACT_FROM_EMAIL=

# Optional Cal.com / Calendly link. When set, a "Book a call" button appears in the contact section.
NEXT_PUBLIC_BOOKING_URL=

# "Ask my AI" chat widget. Works with any OpenAI-compatible API; the defaults use Groq's free tier
# with OpenAI's open-weight gpt-oss-120b (https://console.groq.com/keys, no credit card).
# Without a key, the widget shows a friendly "unavailable, please email me" message.
CHAT_API_KEY=
CHAT_BASE_URL=https://api.groq.com/openai/v1
CHAT_MODEL=openai/gpt-oss-120b

# Optional fallback, used when the main provider is rate-limited or down. Groq's free tier allows
# about one question a minute with this site's prompt; Cerebras' free tier adds ~200 a day
# (https://cloud.cerebras.ai → API Keys).
CHAT_FALLBACK_API_KEY=
CHAT_FALLBACK_BASE_URL=https://api.cerebras.ai/v1
CHAT_FALLBACK_MODEL=gpt-oss-120b

# Admin panel at /admin. Without a password the panel stays locked.
# Changing the password signs out every open session.
ADMIN_PASSWORD=

# Where admin saves go: each save is a commit to this repo, and Vercel redeploys from it.
# Create a fine-grained token (GitHub → Settings → Developer settings → Fine-grained tokens)
# with access to only this repository and "Contents: Read and write".
# Leave these empty in local development to have saves write straight to the files on your computer.
GITHUB_TOKEN=
GITHUB_REPO=nafeesofficial17/my-portfolio-11-2026
GITHUB_BRANCH=main
